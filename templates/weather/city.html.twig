{% extends 'base.html.twig' %}

{# @var location \App\Entity\Location #}
{# @var measurements \App\Entity\Measurement[] #}

{% block title %}Weather in {{ location.city }}, {{ location.country }}{% endblock %}

{% block body %}
    <main>
        <h1>Weather in {{ location.city }}, {{ location.country }}</h1>

        <ul>
            {% for measurement in measurements %}
                <li>{{ measurement.date|date('d.m.Y') }}: {{ measurement.temperature }}&deg;C humidity: {{ measurement.humidity }} wind (km/h): {{ measurement.wind }} Rain Probability: {{ measurement.rainProbability }} </li>
            {% endfor %}
        </ul>
    </main>
{% endblock %}
